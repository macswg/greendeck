*.local.*
.claude/settings.local.json

# TouchDesigner autosaves and backups
Backup/
*.toe.*
CrashAutoSave*

# Logs, scratch, OS and editor clutter
*.log
scratch*
.DS_Store
.vscode/
.idea/
